    m_Localized: "\u0E43\u0E19\u0E2A\u0E16\u0E32\u0E19\u0E01\u0E32\u0E23\u0E13\u0E4C\u0E17\u0E35\u0E48\u0E01\u0E23\u0E30\u0E2A\u0E38\u0E19\u0E2B\u0E21\u0E14
