MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialStage_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: d76dfecea0ce34247a082bf3d882732a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5506125824
    m_Localized: To speak with me, please press 'Talk'.
    m_Metadata:
      m_Items: []
  - m_Id: 412735295488
    m_Localized: Alright... ahem. Welcome to the dungeon that no one would ever enter.
    m_Metadata:
      m_Items: []
  - m_Id: 543442391040
    m_Localized: ...Because the dungeon is too well-hidden.
    m_Metadata:
      m_Items: []
  - m_Id: 766449340416
    m_Localized: How you found it is a mystery to me, but congratulations nonetheless.
    m_Metadata:
      m_Items: []
  - m_Id: 895797481472
    m_Localized: Please proceed to the next room for the next lesson.
    m_Metadata:
      m_Items: []
  - m_Id: 27667322687488
    m_Localized: "I want you to find a key in this room\u2014well, to get through
      the door."
    m_Metadata:
      m_Items: []
  - m_Id: 27911921913856
    m_Localized: "Go ahead\u2014break everything you see."
    m_Metadata:
      m_Items: []
  - m_Id: 28068688220160
    m_Localized: Now, time for combat.
    m_Metadata:
      m_Items: []
  - m_Id: 28173952667648
    m_Localized: Use your sword to perform a melee attack
    m_Metadata:
      m_Items: []
  - m_Id: 28451951136768
    m_Localized: I will put some harmless monsters in the next room.
    m_Metadata:
      m_Items: []
  - m_Id: 28737893617664
    m_Localized: 'Another thing: you can parry the enemy''s attack.'
    m_Metadata:
      m_Items: []
  - m_Id: 28866474201088
    m_Localized: You will know how to do it when you see it coming.
    m_Metadata:
      m_Items: []
  - m_Id: 426537814904832
    m_Localized: Come on, let's get this done!
    m_Metadata:
      m_Items: []
  - m_Id: 426582492631040
    m_Localized: My lunch break is near. Get the gun and go.
    m_Metadata:
      m_Items: []
  - m_Id: 426590449225728
    m_Localized: 'Another thing: the perfect reload allows you to shoot faster.'
    m_Metadata:
      m_Items: []
  - m_Id: 426599106269184
    m_Localized: You will know how to do it when you see it coming.
    m_Metadata:
      m_Items: []
  - m_Id: 426688793071616
    m_Localized: I'm starving.
    m_Metadata:
      m_Items: []
  - m_Id: 504968174948352
    m_Localized: Yeah, that's all of it. You are ready to enter the dungeon now.
    m_Metadata:
      m_Items: []
  - m_Id: 504991784685568
    m_Localized: There are plenty of new things you'll learn and adapt to along the
      way.
    m_Metadata:
      m_Items: []
  - m_Id: 504995920269312
    m_Localized: Remember, to parry is faster than to reload.
    m_Metadata:
      m_Items: []
  - m_Id: 505014400372736
    m_Localized: In certain situations, you'll need to parry while mid-reload.
    m_Metadata:
      m_Items: []
  - m_Id: 505024332484608
    m_Localized: Don't worry, you'll know it when you see it.
    m_Metadata:
      m_Items: []
  - m_Id: 505044364480512
    m_Localized: Now, off you go. And good luck.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
