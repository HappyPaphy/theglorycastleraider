    m_Localized: "\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E40\u0E08\u0E49\u0E32\u0E01\u0E47\u0E08\u0E30\u0E23\u0E39\u0E49\u0E40\u0E2D\u0E07\u0E27\u0E48\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E17\u0E33\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E44\u0E23\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E40\u0E27\u0E25\u0E32\u0E21\u0E32\u0E16\u0E36\u0E07"
